# AWS
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_API_GATEWAY_URL=

# PostgreSQL / Supabase (Phase 1)
# If the DB password contains @ or other reserved URI characters, URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=5
# Backend chart data: false when DATABASE_URL is set and tables are seeded
USE_MOCK_CHART_DATA=true

# API-Sports / API-Football (optional — future sync jobs)
# https://www.api-football.com/
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Anthropic
ANTHROPIC_API_KEY=

# WeChat OAuth
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Feature Flags
EXPO_PUBLIC_BROADCAST_ENABLED=true
EXPO_PUBLIC_FREE_QUERY_LIMIT=20
EXPO_PUBLIC_USE_MOCK_AUTH=false
EXPO_PUBLIC_USE_MOCK_AI_CHAT=false

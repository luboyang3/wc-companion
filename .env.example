# AWS
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Leave empty for local dev (uses Expo Router API routes on same origin).
# Set to a URL for deployed backends (e.g. API Gateway).
EXPO_PUBLIC_API_GATEWAY_URL=

# Sportradar
SPORTRADAR_API_KEY=
SPORTRADAR_BASE_URL=https://api.sportradar.com/soccer/production/v4

# Anthropic (server-side only, used by src/app/ai/chat+api.ts)
ANTHROPIC_API_KEY=

# WeChat OAuth
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Feature Flags
EXPO_PUBLIC_BROADCAST_ENABLED=true
EXPO_PUBLIC_FREE_QUERY_LIMIT=20
EXPO_PUBLIC_USE_MOCK_AUTH=false
EXPO_PUBLIC_USE_MOCK_AI_CHAT=false
